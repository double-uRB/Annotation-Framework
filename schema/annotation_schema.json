{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zetheta Financial Document Classification and Entity Extraction Annotation Schema",
  "type": "object",
  "required": [
    "document_metadata",
    "classification",
    "entities",
    "relationships",
    "quality_metadata",
    "version_control"
  ],
  "properties": {
    "document_metadata": {
      "type": "object",
      "required": ["document_id", "source_file_path", "creation_date", "last_modified", "assigned_annotator", "review_status"],
      "properties": {
        "document_id": { "type": "string" },
        "source_file_path": { "type": "string" },
        "creation_date": { "type": "string", "format": "date-time" },
        "last_modified": { "type": "string", "format": "date-time" },
        "assigned_annotator": { "type": "string" },
        "review_status": { "type": "string", "enum": ["Pending", "Self-Reviewed", "Peer-Reviewed", "Adjudicated", "Gold-Standard"] }
      }
    },
    "classification": {
      "type": "object",
      "required": ["primary_type", "subtype", "quality_tags", "confidence_scores"],
      "properties": {
        "primary_type": {
          "type": "string",
          "enum": [
            "Bank Statement", "Commercial Invoice", "Income Tax Return", "Loan Agreement",
            "Insurance Policy", "Regulatory Filing", "Payment Receipt", "Financial Statement"
          ]
        },
        "subtype": { "type": "string" },
        "quality_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "CLEAN_DIGITAL", "OCR_HIGH_QUALITY", "OCR_DEGRADED", "OCR_NOISY",
              "MULTI_LANGUAGE", "MULTI_CURRENCY", "HANDWRITTEN_ELEMENTS",
              "REDACTED", "TEMPLATE_MISMATCH", "INCOMPLETE"
            ]
          }
        },
        "confidence_scores": {
          "type": "object",
          "properties": {
            "primary_type": { "type": "number", "minimum": 0, "maximum": 1 },
            "subtype": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity_id", "entity_type", "value", "normalized_value", "source_text", "page_number", "bounding_box", "confidence"],
        "properties": {
          "entity_id": { "type": "string" },
          "entity_type": {
            "type": "string",
            "enum": [
              "MONETARY_AMOUNT", "DATE", "ACCOUNT_NUMBER", "PARTY_NAME", "REGULATORY_ID",
              "ADDRESS", "INTEREST_RATE", "DURATION", "PERCENTAGE", "DOCUMENT_ID",
              "CLAUSE_REFERENCE", "TRANSACTION_TYPE", "INSTITUTION_NAME", "PRODUCT_NAME",
              "STATUS", "CONTACT_INFO", "SIGNATURE_BLOCK", "TABLE_DATA", "COMPUTATION",
              "FOOTNOTE_REF", "CURRENCY_CODE", "FISCAL_PERIOD"
            ]
          },
          "value": { "type": "string" },
          "normalized_value": {
            "type": ["string", "number", "object", "null"]
          },
          "source_text": { "type": "string" },
          "page_number": { "type": "integer" },
          "bounding_box": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4,
            "description": "[x_min, y_min, x_max, y_max]"
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "start_char": { "type": "integer" },
          "end_char": { "type": "integer" },
          "linked_entities": {
            "type": "array",
            "items": { "type": "string" }
          },
          "annotator_notes": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "entity_type": { "const": "DATE" } } },
            "then": { "properties": { "normalized_value": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } } }
          },
          {
            "if": { "properties": { "entity_type": { "const": "TRANSACTION_TYPE" } } },
            "then": { "properties": { "normalized_value": { "enum": ["DEBIT", "CREDIT", "TRANSFER", "REVERSAL", "ADJUSTMENT", "REFUND"] } } }
          },
          {
            "if": { "properties": { "entity_type": { "const": "STATUS" } } },
            "then": { "properties": { "normalized_value": { "enum": ["Active", "Lapsed", "Pending", "Approved", "Submitted", "Accepted"] } } }
          }
        ]
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_entity_id", "target_entity_id", "relationship_type"],
        "properties": {
          "source_entity_id": { "type": "string" },
          "target_entity_id": { "type": "string" },
          "relationship_type": {
            "type": "string",
            "enum": [
              "HOLDER_OF_ACCOUNT", "PAYER_OF", "PAYEE_OF", "GUARANTOR_FOR",
              "ISSUED_BY", "COVERS_PERIOD", "COMPUTED_FROM", "REFERENCES_CLAUSE",
              "DENOMINATED_IN", "SIGNED_BY", "EFFECTIVE_ON", "CONTAINS_TABLE",
              "FOOTNOTE_FOR", "SUBSIDIARY_OF"
            ]
          }
        }
      }
    },
    "quality_metadata": {
      "type": "object",
      "required": ["ocr_confidence", "difficulty_rating", "time_to_annotate"],
      "properties": {
        "ocr_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "difficulty_rating": { "type": "integer", "minimum": 1, "maximum": 5 },
        "time_to_annotate": { "type": "integer", "description": "Time in seconds" },
        "review_comments": { "type": "string" }
      }
    },
    "version_control": {
      "type": "object",
      "required": ["schema_version", "guideline_version", "annotator_tool_version"],
      "properties": {
        "schema_version": { "type": "string" },
        "guideline_version": { "type": "string" },
        "annotator_tool_version": { "type": "string" }
      }
    }
  }
}
